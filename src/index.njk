---
layout: layouts/base.njk
---
<div class="scroll-driver" id="scroll-driver">
  <div class="sticky-scene" id="scene">
    <div class="hero-bg"></div>
    <div class="ambient-orb ambient-orb-gold"></div>
    <div class="ambient-orb ambient-orb-blue"></div>

    <div class="hero-text" id="hero-text">
      <h1>Where Delhi's<br><em>Pythonistas</em><br><span class="light-text">come together.</span></h1>
      <p class="hero-subtitle">Monthly meetups, workshops, and open source sprints. Free, welcoming, powered by community.</p>
      <div class="hero-actions">
        <a href="https://www.commudle.com/communities/pydelhi" class="btn-primary" target="_blank" rel="noopener">Join on Commudle →</a>
        <!-- TODO: WhatsApp community invite link -->
        <a href="#" class="btn-ghost">Join WhatsApp Community</a>
      </div>
    </div>

    <div id="grid-layer">
      <div class="grid-card">
        <div class="profile-row">
          <img src="https://raw.githubusercontent.com/pydelhi/resources/refs/heads/main/logos/pydelhi-black.png" alt="PyDelhi" class="profile-avatar" style="object-fit:contain;background:transparent;">
          <div><div class="profile-name">PyDelhi Community</div><div class="profile-bio">We write Python. We learn together. We have chai after.</div></div>
          <a href="https://www.commudle.com/communities/pydelhi" class="join-btn" target="_blank" rel="noopener">+ Join community</a>
        </div>
        <div class="bento-grid">
          <div class="bento-cell bento-cell-tall" id="bento-cell-0"><div class="ghost-placeholder" id="ghost-0"><div class="ghost-bar"></div></div><template>{% photo "photos/speaker-on-stage.jpg", "Talks", "(max-width: 860px) 50vw, 400px", { draggable: "false" } %}</template></div>
          <div class="bento-cell"                 id="bento-cell-1"><div class="ghost-placeholder" id="ghost-1"><div class="ghost-bar"></div></div><template>{% photo "photos/full-house-group.jpeg", "Meetups", "(max-width: 860px) 50vw, 400px", { draggable: "false" } %}</template></div>
          <div class="bento-cell"                 id="bento-cell-2"><div class="ghost-placeholder" id="ghost-2"><div class="ghost-bar"></div></div><template>{% photo "photos/iwd-meetup.jpeg", "Workshops", "(max-width: 860px) 50vw, 400px", { draggable: "false" } %}</template></div>
          <div class="bento-cell bento-cell-info">
            {%- set next = events.next %}
            <div class="info-card info-card-registration" id="meetup-card" style="grid-column: span 2; width: 100%; padding: 14px;">
              <span class="info-chip info-chip-open">{{ "Upcoming" if next else "Coming soon" }}</span>
              <div class="info-title">{{ next.name if next else "Next Meetup" }}</div>
              <div class="info-body">{{ "Python talks, lightning sessions, and great conversations over chai. Everyone's welcome." if next else "Date and venue coming soon. Join PyDelhi on Commudle to hear first." }}</div>
              <div class="meetup-meta">
                <div class="meetup-meta-item">
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="12" height="12" rx="2"/><path d="M11 1v4M5 1v4M2 7h12"/></svg>
                  <span>{{ next.dayLong if next else "Date coming soon" }}</span>
                </div>
                <div class="meetup-meta-item">
                  <svg width="13" height="13" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1.5a4.5 4.5 0 0 0-4.5 4.5c0 3.5 4.5 8.5 4.5 8.5s4.5-5 4.5-8.5A4.5 4.5 0 0 0 8 1.5z"/><circle cx="8" cy="6" r="1.5"/></svg>
                  <span>{{ (next.venue or "Delhi NCR") if next else "Delhi NCR" }}</span>
                </div>
              </div>
              <div class="meetup-actions">
                <a href="{{ next.url if next else "https://www.commudle.com/communities/pydelhi" }}" class="meetup-btn-primary" target="_blank" rel="noopener">
                  <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 10L10 2M10 2H4M10 2v6"/></svg>
                  {{ "Register now" if next else "Get notified" }}
                </a>
                <a href="/speak" class="meetup-btn-secondary">
                  <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5.5" y="1" width="5" height="9" rx="2.5"/><path d="M3 8a5 5 0 0 0 10 0M8 13v2"/></svg>
                  Submit talk
                </a>
              </div>
            </div>
          </div>
          <div class="bento-cell bento-cell-talk" id="bento-cell-3"><div class="ghost-placeholder" id="ghost-3"><div class="ghost-bar"></div></div><template>{% photo "photos/bof.jpg", "Birds of a Feather", "(max-width: 860px) 50vw, 400px", { draggable: "false" } %}</template></div>
        </div>
      </div>
    </div>
  </div>
</div>

<main>

  <!-- STATS: meetup history as a contribution graph. Data: src/_data/meetupHistory.js (Commudle from 2025) -->
  <section class="stats" aria-labelledby="stats-title">
    <div class="wrap">
      <h2 class="h2" id="stats-title"><span id="meetup-total">{{ meetupHistory.total }}</span>+ meetups since 2011.</h2>
      <div class="graph-card" data-reveal>
        <div class="graph-main">
          <div class="graph-wrap">
            <div class="graph" id="graph" role="img" aria-label="Grid of every month since 2011, filled for each month PyDelhi met">
              {%- for c in meetupHistory.cells %}<span class="cell {{ c.cls }}" data-label="{{ c.label }}"></span>{% endfor -%}
            </div>
            <div class="graph-ends" aria-hidden="true"><span>2011</span><span>Today</span></div>
            <div class="graph-tip" id="graph-tip" aria-hidden="true"></div>
          </div>
          <ul class="graph-legend">
            <li><span class="sw sw-met"></span>Meetup</li>
            <li><span class="sw sw-none"></span>No meetup</li>
          </ul>
        </div>
        <div class="graph-side">
          <!-- TODO confirm these numbers -->
          <dl class="stat-pair">
            <div><dt>Speakers on stage</dt><dd>350+</dd></div>
            <div><dt>Community members</dt><dd>12k+</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- SPEAKER COMPANIES: lists live in script.js -->
  <section class="speakers-from" aria-label="Speaker companies, past sponsors and venues">
    <div class="wrap">
      <h2 class="speakers-from-title" id="speakers-from-title">Our speakers have come from</h2>
      <div class="marquee">
        <div class="marquee-track" id="speaker-logos"></div>
      </div>

      <h2 class="speakers-from-title" id="sponsors-title">Past sponsors &amp; venues</h2>
      <div class="marquee marquee-reverse">
        <div class="marquee-track" id="sponsor-logos"></div>
      </div>
    </div>
  </section>

  <!-- ABOUT SNIPPET -->
  <section class="about" aria-labelledby="about-title">
    <div class="wrap">
      <div class="about-intro">
        <h2 class="h2" id="about-title">One Saturday a month, many ways in.</h2>
        <p class="lede">PyDelhi is volunteer-run and free. Students, hobbyists and people who ship Python for a living all share the same room.</p>
      </div>

      <ul class="formats" id="formats">
        <li class="format" tabindex="0" data-img="{% photoUrl "photos/speaker-on-stage.jpg", 640 %}">
          {% photo "photos/speaker-on-stage.jpg", "", "120px", { class: "format-thumb", loading: "lazy" } %}
          <span class="format-name">Talks</span>
          <span class="format-desc">20 to 30 minutes on something you built, broke or learned.</span>
        </li>
        <li class="format" tabindex="0" data-img="{% photoUrl "photos/iwd-meetup.jpeg", 640 %}">
          {% photo "photos/iwd-meetup.jpeg", "", "120px", { class: "format-thumb", loading: "lazy" } %}
          <span class="format-name">Workshops</span>
          <span class="format-desc">Laptops open, code along, leave with something working.</span>
        </li>
        <li class="format" tabindex="0" data-img="{% photoUrl "photos/bof.jpg", 640 %}">
          {% photo "photos/bof.jpg", "", "120px", { class: "format-thumb", loading: "lazy" } %}
          <span class="format-name">Birds of a Feather</span>
          <span class="format-desc">Small circles around one topic. Everyone gets a turn.</span>
        </li>
        <li class="format" tabindex="0" data-img="{% photoUrl "photos/speaker-qr-slide.jpeg", 640 %}">
          {% photo "photos/speaker-qr-slide.jpeg", "", "120px", { class: "format-thumb", loading: "lazy" } %}
          <span class="format-name">Lightning Talks</span>
          <span class="format-desc">Five minutes, one idea, slides optional.</span>
        </li>
      </ul>
      <div class="format-preview" id="format-preview" aria-hidden="true"></div>
      <a href="/about" class="text-link">and more, read about PyDelhi <i class="ph ph-arrow-right"></i></a>
    </div>
  </section>

  <!-- PHOTO STRIP -->
  <section class="gallery" aria-labelledby="gallery-title">
    <div class="wrap gallery-head">
      <h2 class="h2" id="gallery-title">Saturdays look like this.</h2>
      <div class="gallery-controls">
        <button class="round-btn" data-strip="-1" aria-label="Previous photos"><i class="ph ph-arrow-left"></i></button>
        <button class="round-btn" data-strip="1" aria-label="Next photos"><i class="ph ph-arrow-right"></i></button>
      </div>
    </div>
    <div class="strip" id="strip" tabindex="0" aria-label="Photos from past meetups">
      <figure class="shot shot-wide">{% photo "photos/meetup-group-photo.jpeg", "Group photo of attendees at a PyDelhi meetup", "(max-width: 600px) 80vw, 520px", { loading: "lazy", draggable: "false" } %}</figure>
      <figure class="shot">{% photo "photos/aiohttp-talk.jpeg", "Speaker presenting a talk on installing aiohttp", "(max-width: 600px) 80vw, 520px", { loading: "lazy", draggable: "false" } %}</figure>
      <figure class="shot shot-land">{% photo "photos/bof.jpg", "Attendees in a Birds of a Feather discussion circle", "(max-width: 600px) 80vw, 520px", { loading: "lazy", draggable: "false" } %}</figure>
      <figure class="shot">{% photo "photos/speaker-qr-slide.jpeg", "Speaker sharing a QR code slide with the audience", "(max-width: 600px) 80vw, 520px", { loading: "lazy", draggable: "false" } %}</figure>
      <figure class="shot shot-pano">{% photo "photos/full-house-group.jpeg", "Large group photo from a full-house PyDelhi meetup", "(max-width: 600px) 80vw, 520px", { loading: "lazy", draggable: "false" } %}</figure>
      <figure class="shot shot-land">{% photo "photos/iwd-meetup.jpeg", "PyDelhi International Women's Day meetup", "(max-width: 600px) 80vw, 520px", { loading: "lazy", draggable: "false" } %}</figure>
      <figure class="shot shot-sq">{% photo "photos/speaker-on-stage.jpg", "A speaker on stage at PyDelhi", "(max-width: 600px) 80vw, 520px", { loading: "lazy", draggable: "false" } %}</figure>
    </div>
  </section>

  <!-- EVENTS -->
  <section class="events" aria-labelledby="events-title">
    <div class="wrap">
      <h2 class="h2" id="events-title">Next up, and what you missed.</h2>
      <div class="events-grid">

        <!-- the ticket's notches are a mask, so its outline and shadow live on this wrapper -->
        {% include "ticket.njk" %}

        <div class="past">
          {%- for ev in events.past.slice(0, 2) %}
          {% include "past-card.njk" %}
          {%- endfor %}
          <a href="/events" class="text-link">View all events <i class="ph ph-arrow-right"></i></a>
        </div>
      </div>
    </div>
  </section>

  <!-- SPONSOR / COLLABORATE -->
  <section class="partner" aria-labelledby="partner-title">
    <div class="wrap">
      <h2 class="h2" id="partner-title">Help a room full of developers show up.</h2>
      <div class="switch" role="tablist" aria-label="Ways to support PyDelhi">
        <button class="switch-btn" role="tab" id="tab-sponsor" aria-controls="pane-sponsor" aria-selected="true">Sponsor</button>
        <button class="switch-btn" role="tab" id="tab-collab" aria-controls="pane-collab" aria-selected="false" tabindex="-1">Collaborate</button>
      </div>

      <div class="partner-pane pane-sponsor" id="pane-sponsor" role="tabpanel" aria-labelledby="tab-sponsor">
        {% photo "photos/iwd-meetup.jpeg", "A full room of attendees at a PyDelhi meetup", "(max-width: 860px) 100vw, 520px", { class: "pane-img", loading: "lazy" } %}
        <div class="pane-body">
          <p class="pane-intro">Every meetup is free for attendees. Sponsors make that possible, and meet the people who use their tools.</p>
          <dl class="pane-list">
            <div><i class="ph ph-buildings" aria-hidden="true"></i><dt>Venue</dt><dd>Host us for a Saturday afternoon.</dd></div>
            <div><i class="ph ph-coffee" aria-hidden="true"></i><dt>Food &amp; chai</dt><dd>Keep the conversations going after the talks.</dd></div>
            <div><i class="ph ph-hand-coins" aria-hidden="true"></i><dt>Monetary</dt><dd>Fund recordings, swag and travel for speakers.</dd></div>
          </dl>
          <p class="pane-note">Sponsors get logo placement, a shoutout on stage and in our recap posts.</p>
        </div>
      </div>

      <div class="partner-pane pane-collab" id="pane-collab" role="tabpanel" aria-labelledby="tab-collab" hidden>
        {% photo "photos/speaker-qr-slide.jpeg", "A speaker presenting to a PyDelhi audience", "(max-width: 860px) 100vw, 520px", { class: "pane-img", loading: "lazy" } %}
        <div class="pane-body">
          <p class="pane-intro">Run something together with another community, college or company.</p>
          <dl class="pane-list">
            <div><i class="ph ph-users-three" aria-hidden="true"></i><dt>Collab events</dt><dd>Joint meetups and workshops.</dd></div>
            <div><i class="ph ph-handshake" aria-hidden="true"></i><dt>Community partnerships</dt><dd>Long-term, shared calendars and speakers.</dd></div>
            <div><i class="ph ph-megaphone" aria-hidden="true"></i><dt>Cross-promotion</dt><dd>We share your events, you share ours.</dd></div>
          </dl>
          <!-- TODO: point this at the collaboration proposals repo/issue form -->
          <p class="pane-note">Have a proposal for collaboration already? <a href="https://github.com/pydelhi" target="_blank" rel="noopener">Submit it here <i class="ph ph-github-logo"></i></a></p>
        </div>
      </div>

      <div class="partner-cta">
        <a href="/sponsor" class="btn-navy">Get in touch <i class="ph ph-arrow-right"></i></a>
      </div>
    </div>
  </section>

  <!-- SPEAK -->
  <section class="speak" aria-labelledby="speak-title">
    <div class="wrap">
      <div class="speak-panel">
      <div class="speak-head">
        <h2 class="h2" id="speak-title">Got five minutes? <em>Or ninety?</em></h2>
        <p class="lede">First-time speakers, students and seasoned engineers all share the same stage. Pick the length that fits your idea. Talks may be recorded for our YouTube channel.</p>
      </div>

      <div class="ruler" id="ruler" data-reveal>
        <div class="ruler-scale" aria-hidden="true">
          <span style="--at:0">0</span><span style="--at:15">15</span><span style="--at:30">30</span><span style="--at:45">45</span><span style="--at:60">60</span><span style="--at:75">75</span><span style="--at:90">90 min</span>
        </div>
        <div class="ruler-row">
          <span class="ruler-name"><i class="ph ph-lightning"></i>Lightning talk</span>
          <span class="ruler-bar" style="--from:0;--to:5"><span>5 min</span></span>
        </div>
        <div class="ruler-row">
          <span class="ruler-name"><i class="ph ph-presentation-chart"></i>Full talk</span>
          <span class="ruler-bar" style="--from:0;--to:30"><span>20 to 30 min</span></span>
        </div>
        <div class="ruler-row">
          <span class="ruler-name"><i class="ph ph-laptop"></i>Workshop</span>
          <span class="ruler-bar ruler-bar-long" style="--from:0;--to:90"><span>60 to 90 min, hands-on</span></span>
        </div>
        <div class="ruler-row">
          <span class="ruler-name"><i class="ph ph-chats-circle"></i>Birds of a Feather</span>
          <span class="ruler-bar ruler-bar-open" style="--from:0;--to:60"><span>open-ended</span></span>
        </div>
      </div>

      <div class="speak-foot">
        <p>Topics we love: web, data, ML, tooling, testing, packaging, Python internals and the odd side project that got out of hand.</p>
        <a href="/speak" class="btn-navy">Submit a Talk <i class="ph ph-arrow-right"></i></a>
      </div>
      </div>
    </div>
  </section>

  <!-- VOLUNTEER -->
  <section class="volunteer" aria-labelledby="volunteer-title">
    <div class="wrap vol">
      <!-- TODO: swap for a photo of volunteers at work -->
      {% photo "photos/meetup-group-photo.jpeg", "PyDelhi volunteers and attendees at a meetup", "(max-width: 860px) 100vw, 560px", { class: "vol-img", loading: "lazy" } %}
      <div class="vol-body">
        <h2 class="h2" id="volunteer-title">Help us run the room.</h2>
        <p class="lede">Every meetup is put together by volunteers. Pick what you're good at, or tell us something new.</p>
        <ul class="vol-roles">
          <li><i class="ph ph-palette" aria-hidden="true"></i>Graphic design</li>
          <li><i class="ph ph-browser" aria-hidden="true"></i>Web design</li>
          <li><i class="ph ph-instagram-logo" aria-hidden="true"></i>Social media</li>
          <li><i class="ph ph-pencil-simple" aria-hidden="true"></i>Content writing</li>
          <li><i class="ph ph-check-square-offset" aria-hidden="true"></i>CFP review</li>
          <li><i class="ph ph-briefcase" aria-hidden="true"></i>Marketing</li>
          <li><i class="ph ph-clipboard-text" aria-hidden="true"></i>On-ground: logistics, registrations</li>
          <li><i class="ph ph-dots-three" aria-hidden="true"></i>Something else</li>
        </ul>
        <!-- TODO: Google Form link for volunteer sign-ups -->
        <a href="#" class="btn-navy" target="_blank" rel="noopener">Volunteer with us <i class="ph ph-arrow-up-right"></i></a>
      </div>
    </div>
    <!-- MASCOT: drawn by script.js, lies on the section's bottom edge and slithers in as you scroll -->
    <svg class="snake snake-divider" id="snake-loop" aria-hidden="true"></svg>
  </section>

  <!-- JOIN -->
  <section class="join" id="join" aria-labelledby="join-title">
    <div class="join-photos" aria-hidden="true">
      <span class="join-photo jp-1" data-drift="-60">{% photo "photos/speaker-on-stage.jpg", "", "260px" %}</span>
      <span class="join-photo jp-2" data-drift="40">{% photo "photos/meetup-group-photo.jpeg", "", "260px" %}</span>
      <span class="join-photo jp-3" data-drift="-30">{% photo "photos/bof.jpg", "", "260px" %}</span>
      <span class="join-photo jp-4" data-drift="70">{% photo "photos/aiohttp-talk.jpeg", "", "260px" %}</span>
      <span class="join-photo jp-5" data-drift="-50">{% photo "photos/iwd-meetup.jpeg", "", "260px" %}</span>
    </div>
    <div class="join-inner">
      <h2 class="join-title" id="join-title">Save yourself a seat <em>at the next one.</em></h2>
      <p class="lede">Free, every month, somewhere in Delhi NCR. Join to hear about it first.</p>
      <div class="hero-actions">
        <a href="https://www.commudle.com/communities/pydelhi" class="btn-primary" target="_blank" rel="noopener">Join on Commudle →</a>
        <!-- TODO: WhatsApp community invite link -->
        <a href="#" class="btn-ghost">Join WhatsApp Community</a>
      </div>
    </div>
  </section>

</main>
