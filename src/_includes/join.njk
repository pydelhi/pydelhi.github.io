  <!-- JOIN -->
  <section class="join" id="join" aria-labelledby="join-title">
    <div class="join-photos" aria-hidden="true">
      <span class="join-photo jp-1" data-drift="-60">{% photo "photos/speaker-on-stage.jpg", "", "260px" %}</span>
      <span class="join-photo jp-2" data-drift="40">{% photo "photos/april-meetup-group.jpg", "", "260px" %}</span>
      <span class="join-photo jp-3" data-drift="-30">{% photo "photos/birds-of-a-feather.jpg", "", "260px" %}</span>
