{#- Sponsor page: the thank-you slide every meetup opens and closes on. script.js fills in past sponsors' logos
    and leaves the last spot for you. No blank lines: Markdown includes this -#}
<figure class="thanks" data-reveal>
  <div class="thanks-screen">
    <p class="thanks-title">Thank you to our <em>sponsors</em></p>
    <div class="thanks-logos" id="thanks-logos">
      <a class="thanks-you" href="{{ site.discussions }}" target="_blank" rel="noopener"><i class="ph ph-plus"></i> Your logo</a>
    </div>
  </div>
  <figcaption>Some of the companies and venues that have hosted, fed or funded a PyDelhi meetup.</figcaption>
</figure>
