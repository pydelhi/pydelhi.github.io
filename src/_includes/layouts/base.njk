<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{#- every page: title, description, canonical URL and the preview card shown when a link is shared.
    A blog post's card uses its cover photo; every other page the default card in assets/icons/ -#}
{%- set pageTitle = (title + " | PyDelhi" if isPost else title) or "PyDelhi | " + site.tagline %}
{%- set pageDescription = description or summary or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- if site.preview %}
<meta name="robots" content="noindex">
{%- endif %}
<meta name="theme-color" content="#00296B">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/assets/icons/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:site_name" content="PyDelhi">
<meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
<meta property="og:title" content="{{ title if isPost else pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- set ogImage = cover or "icons/og-default.jpg" %}
<meta property="og:image" content="{{ site.url }}{% photoUrl ogImage, 1200 %}">
<meta property="og:image:alt" content="{{ ('Photo from ' + title) if cover else "PyDelhi: where Delhi's Pythonistas come together" }}">
<meta property="og:locale" content="en_IN">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@pydelhi">
{%- if page.url == "/" %}
{#- tells search engines who PyDelhi is, for the knowledge panel beside search results #}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org", "@type": "Organization", "name": "PyDelhi", "alternateName": site.tagline,
  "url": site.url + "/", "logo": site.url + "/assets/icons/icon-512.png", "email": site.email, "foundingDate": "2011",
  "description": site.description, "sameAs": [site.commudle, site.github, site.linkedin, site.x, site.youtube]
} | dump | safe }}
</script>
{%- endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
<link rel="stylesheet" href="/styles.css">
</head>
<body>

<nav id="site-nav">
  <a href="/" class="nav-logo" aria-label="PyDelhi home">
    <img src="/assets/brand/pydelhi-wordmark.svg" alt="PyDelhi">
  </a>
  <div class="nav-links" id="nav-links">
    {%- for item in site.nav %}
    <a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>{% if item.title %}<abbr title="{{ item.title }}">{{ item.label }}</abbr>{% else %}{{ item.label }}{% endif %}</a>
    {%- endfor %}
  </div>
  <a href="{{ site.commudle }}" class="nav-cta" target="_blank" rel="noopener">
    Join community <i class="ph ph-arrow-up-right"></i>
  </a>
  <button class="nav-toggle" id="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
    <i class="ph ph-list"></i>
  </button>
</nav>

{{ content | safe }}

<footer class="footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/assets/brand/pydelhi-wordmark.svg" alt="PyDelhi" class="footer-logo">
        <p>Delhi NCR's Python community. Free, volunteer-run, open to everyone.</p>
        <span class="footer-socials">
          <a href="{{ site.github }}" aria-label="PyDelhi on GitHub" target="_blank" rel="noopener"><i class="ph ph-github-logo"></i></a>
          <a href="{{ site.x }}" aria-label="PyDelhi on X" target="_blank" rel="noopener"><i class="ph ph-x-logo"></i></a>
          <a href="{{ site.linkedin }}" aria-label="PyDelhi on LinkedIn" target="_blank" rel="noopener"><i class="ph ph-linkedin-logo"></i></a>
          <a href="https://www.instagram.com/pydelhi" aria-label="PyDelhi on Instagram" target="_blank" rel="noopener"><i class="ph ph-instagram-logo"></i></a>
        </span>
      </div>
      {#- one column per kind of visitor: coming to a meetup, taking part, catching up, and organisations #}
      <div class="footer-cols">
        <div>
          <h4>Come to a meetup</h4>
          <a href="{{ site.commudle }}" target="_blank" rel="noopener">Next meetup on Commudle</a>
          <a href="{{ site.whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>
          <a href="{{ site.telegram }}" target="_blank" rel="noopener">Telegram</a>
          <a href="{{ site.mailingList }}" target="_blank" rel="noopener">Mailing list</a>
          <a href="/coc/">Code of Conduct</a>
        </div>
        <div>
          <h4>Take part</h4>
          <a href="/speak/">Host a session</a>
          <a href="{{ site.speakingGuidelines }}" target="_blank" rel="noopener">Speaker guidelines</a>
          <a href="/volunteer/">Volunteer</a>
          <a href="/about/">About PyDelhi</a>
        </div>
        <div>
          <h4>Catch up</h4>
          <a href="{{ site.youtube }}" target="_blank" rel="noopener">Talk recordings</a>
          <a href="{{ site.pastTalks }}" target="_blank" rel="noopener">Past talks</a>
          <a href="/blog/">Meetup recaps</a>
        </div>
        <div>
          <h4>Work with us</h4>
          <a href="/sponsor/">Sponsor or host</a>
          <a href="{{ site.githubSponsors }}" target="_blank" rel="noopener">GitHub Sponsors</a>
          <a href="{{ site.communityPartnership }}" target="_blank" rel="noopener">Community partnership</a>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 PyDelhi. Run by volunteers.</span>
      <span>Made with <span class="heart" aria-label="love">♥</span> by <a href="https://daksh.design" target="_blank" rel="noopener">daksh.design</a></span>
    </div>
  </div>
  <svg class="snake snake-footer" id="snake-footer" aria-hidden="true"></svg>
</footer>

<script src="/script.js"></script>
</body>
</html>
