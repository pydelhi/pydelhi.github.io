---
layout: layouts/base.njk
---
{#- Inner pages: a centred title and lede, then the page's own sections. Front matter: heading (HTML), lede, actions, join -#}
<main class="page{% if pageClass %} {{ pageClass }}{% endif %}">

  <header class="page-head">
    <!-- MASCOT: script.js poses it around the title, see PAGE SNAKES -->
    <svg class="snake snake-title" id="snake-title" aria-hidden="true"></svg>
    <div class="wrap">
      <h1 class="page-title">{{ heading | safe }}</h1>
      {%- if lede %}
      <p class="lede">{{ lede | safe }}</p>
      {%- endif %}
      {%- if actions %}
      <div class="page-actions">
        {%- for a in actions %}
        <a href="{{ a.url }}" class="{{ a.class or 'btn-navy' }}"{% if a.url.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ a.label }} <i class="ph ph-{{ a.icon or ('arrow-up-right' if a.url.startsWith('http') else 'arrow-right') }}"></i></a>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </header>

{{ content | safe }}

{#- not an if block: Nunjucks drops the async {% photo %} output of an include inside one, so pick the template instead -#}
{% include ("join.njk" if join else "no-join") ignore missing %}
</main>
