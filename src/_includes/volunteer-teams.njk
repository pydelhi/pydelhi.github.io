{#- Teams and people from _data/volunteerTeams.json (copied from github.com/pydelhi/volunteers) -#}
<div class="tiles">
  {%- for team in volunteerTeams.teams %}
  <div class="tile" data-reveal>
    <span class="tile-icon"><i class="ph ph-{{ team.icon }}" aria-hidden="true"></i></span>
    <h3>{{ team.name }}</h3>
    <p>{{ team.about }}</p>
    <ul class="team-people">
      {%- for person in team.people %}<li>{{ person }}</li>{% endfor -%}
    </ul>
  </div>
  {%- endfor %}
</div>
