{#- Volunteers page: the teams as closing credits, from _data/volunteerTeams.json (copied from github.com/pydelhi/volunteers).
    No blank lines: Markdown includes this -#}
<dl class="credits">
  {%- for team in volunteerTeams.teams %}
  <div data-reveal>
    <dt>{{ team.name }}<span>{{ team.about }}</span></dt>
    <dd>{% for person in team.people %}<span>{{ person }}</span>{% endfor %}</dd>
  </div>
  {%- endfor %}
</dl>
