{#- Volunteers page: a meetup Saturday, one lane per role (_data/runOfShow.json). Desktop is a grid with the snake along
    the phases; phones get the same jobs phase by phase down a vertical snake. No blank lines: Markdown includes this -#}
<div class="show" data-rail="x" style="--phases:{{ runOfShow.phases.length }}">
  <svg class="snake rail-snake" aria-hidden="true"></svg>
  <div class="show-grid" role="table" aria-label="Who does what on a meetup Saturday">
    <div class="show-corner" role="columnheader"></div>
    {%- for ph in runOfShow.phases %}
    <div class="show-phase" role="columnheader" style="grid-column:{{ loop.index + 1 }}"><span class="show-dot" data-rail-stop></span>{{ ph }}</div>
    {%- endfor %}
    {%- for lane in runOfShow.lanes %}
    {%- set row = loop.index + 1 %}
    <div class="show-role" role="rowheader" style="grid-row:{{ row }}"><i class="ph ph-{{ lane.icon }}" aria-hidden="true"></i>{{ lane.role }}</div>
    {%- for t in lane.tasks %}
    <div class="show-task" role="cell" data-phase="{{ t.from }}" style="grid-row:{{ row }};grid-column:{{ t.from + 2 }} / {{ t.to + 3 }}">{{ t.text }}</div>
    {%- endfor %}
    {%- endfor %}
  </div>
</div>
<div class="show-list" data-rail>
  <svg class="snake rail-snake" aria-hidden="true"></svg>
  <ol>
    {%- for ph in runOfShow.phases %}
    {%- set phase = loop.index0 %}
    <li>
      <h3><span class="show-dot" data-rail-stop></span>{{ ph }}</h3>
      <ul>
        {%- for lane in runOfShow.lanes %}{% for t in lane.tasks %}{% if t.from == phase %}
        <li data-phase="{{ phase }}"><i class="ph ph-{{ lane.icon }}" aria-hidden="true"></i><span><strong>{{ lane.role }}</strong>{{ t.text }}</span></li>
        {%- endif %}{% endfor %}{% endfor %}
      </ul>
    </li>
    {%- endfor %}
  </ol>
</div>
