{#- One past meetup. Expects `ev`: a Commudle event from _data/events.js -#}
<a href="{{ ev.url }}" class="past-card" data-reveal target="_blank" rel="noopener">
            {% if ev.photo -%}
            <span class="past-img{% if ev.banner %} past-banner{% endif %}">{% photo ev.photo, ("" if ev.banner else "Photo from " + ev.name), "(max-width: 600px) 110px, 168px", { loading: "lazy" } %}</span>
            {%- else -%}
            <span class="past-img past-gen"><span class="past-gen-logo"></span></span>
            {%- endif %}
            <span class="past-body">
              <span class="past-date">{{ ev.monthYear }}</span>
              <strong>{{ ev.name }}</strong>
            </span>
            <i class="ph ph-arrow-up-right past-arrow"></i>
          </a>
