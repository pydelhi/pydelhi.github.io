          <span class="ruler-bar ruler-bar-long" style="--from:0;--to:90"><span>60 to 90 min, hands-on</span></span>
        </div>
        <div class="ruler-row">
          <span class="ruler-name"><i class="ph ph-chats-circle"></i>Birds of a Feather</span>
          <span class="ruler-bar ruler-bar-open" style="--from:0;--to:60"><span>open-ended</span></span>
        </div>
      </div>
