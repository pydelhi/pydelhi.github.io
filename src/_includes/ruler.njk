      <div class="ruler" id="ruler" data-reveal>
        <div class="ruler-scale" aria-hidden="true">
          <span style="--at:0">0</span><span style="--at:15">15</span><span style="--at:30">30</span><span style="--at:45">45</span><span style="--at:60">60</span><span style="--at:75">75</span><span style="--at:90">90 min</span>
