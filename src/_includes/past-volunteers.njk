  <div data-reveal>
    <dt>Past organisers and volunteers<span>Thank you for the Saturdays you gave.</span></dt>
    <dd>{% for person in pastVolunteers %}<span>{{ person }}</span>{% endfor %}</dd>
  </div>
</dl>
