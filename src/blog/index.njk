---
layout: layouts/page.njk
title: Blog | PyDelhi
description: Recaps of PyDelhi meetups, sprints and workshops, written by the people who were there.
heading: Recaps, <em>straight from the room.</em>
lede: What happened at PyDelhi meetups, sprints and workshops, written up by the people who were there.
permalink: /blog/
---
{#- The newest recent recap runs large, then the rest of the last two years sit on one shelf per year, each
    with the snake lying along it. Older recaps go to the archive below as a plain list (collections in eleventy.config.js) -#}
{%- set latest = collections.recentPosts[0] %}
{%- if latest %}
<section class="page-section">
  <div class="wrap">
    <a href="{{ latest.url }}" class="post-feature" data-reveal>
      {% if latest.data.cover %}<span class="past-img">{% photo latest.data.cover, "", "(max-width: 860px) 100vw, 620px" %}</span>
      {% else %}<span class="past-img past-gen"><span class="past-gen-logo"></span></span>{% endif %}
      <span class="post-feature-body">
        <span class="past-date">{{ latest.data.dateLabel }}</span>
        <strong>{{ latest.data.title }}</strong>
        {%- if latest.data.summary %}<span class="post-card-sum">{{ latest.data.summary }}</span>{% endif %}
        <span class="post-card-by">By {{ latest.data.author }}</span>
        <span class="text-link">Read the recap <i class="ph ph-arrow-right"></i></span>
      </span>
    </a>
    {%- for shelf in collections.postsByYear %}
    {%- set posts = shelf.posts | reject("equalto", latest) %}
    {%- if posts.length %}
    <section class="shelf" aria-labelledby="year-{{ shelf.year }}">
      <div class="shelf-head">
        <h2 id="year-{{ shelf.year }}">{{ shelf.year }}</h2>
        <svg class="snake shelf-snake" aria-hidden="true"></svg>
      </div>
      <div class="post-grid">
        {%- for post in posts %}
        <a href="{{ post.url }}" class="post-card" data-reveal>
          {% if post.data.cover %}<span class="past-img">{% photo post.data.cover, "", "(max-width: 860px) 100vw, 360px", { loading: "lazy" } %}</span>
          {% else %}<span class="past-img past-gen"><span class="past-gen-logo"></span></span>{% endif %}
          <span class="post-card-body">
            <span class="past-date">{{ post.data.monthLabel }}</span>
            <strong>{{ post.data.title }}</strong>
            <span class="post-card-by">By {{ post.data.author }}</span>
          </span>
        </a>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- if collections.archiveByYear.length %}
<section class="page-section" aria-labelledby="archive-title">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2" id="archive-title">From the archive</h2>
      <p class="lede">Recaps more than two years old, kept for the record.</p>
    </div>
    <div class="archive">
      {%- for shelf in collections.archiveByYear %}
      <section class="archive-year" aria-labelledby="archive-{{ shelf.year }}">
        <h3 id="archive-{{ shelf.year }}">{{ shelf.year }}</h3>
        <ul>
          {%- for post in shelf.posts %}
          <li data-reveal><a href="{{ post.url }}">
            <span class="archive-date">{{ post.data.monthLabel }}</span>
            <span class="archive-title"><strong>{{ post.data.title }}</strong><span>By {{ post.data.author }}</span></span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a></li>
          {%- endfor %}
        </ul>
      </section>
      {%- endfor %}
    </div>
  </div>
</section>
{%- endif %}
